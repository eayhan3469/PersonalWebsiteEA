# Response headers (Netlify / Cloudflare _headers format).
# NOTE: both hosts apply EVERY matching rule and concatenate same-named
# headers (no "most specific wins"). Keep a single /* rule rather than
# per-path Cache-Control overrides that would conflict.
# Filenames aren't content-hashed; revalidate every load (ETag -> cheap 304).
# The CDN edge still caches, so origin hits stay low.

/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-THFwRIr8dC8IEs2XqjCX8otFM0IyHqqoWnKoEZoTb8c='; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self' https://api.web3forms.com; form-action 'self' mailto:; base-uri 'self'; frame-ancestors 'self'
