{
  // Static-site config for Cloudflare Workers (Workers Builds).
  // The site is plain files in the repo root — no build step.
  "name": "personalwebsiteea",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./",
    // serve /404.html for any path that doesn't match a file
    "not_found_handling": "404-page"
  }
}
